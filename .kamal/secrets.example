# Copy to `.kamal/secrets` (gitignored) before the first deploy.
# Values can come from ENV, a password manager, or a local export.
# Do not commit the real `.kamal/secrets` file.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SECRET_KEY_BASE=$SECRET_KEY_BASE
RAILS_RUNNER_DATABASE_PASSWORD=$RAILS_RUNNER_DATABASE_PASSWORD
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
ADMIN_PASSWORD=$ADMIN_PASSWORD
