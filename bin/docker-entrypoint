#!/bin/bash
set -euo pipefail

cd /app

if [ -f tmp/pids/server.pid ]; then
  rm -f tmp/pids/server.pid
fi

if [ "${RAILS_ENV:-development}" != "production" ]; then
  if [ -f Gemfile ]; then
    bundle check >/dev/null 2>&1 || bundle install
  fi

  if [ -f package.json ]; then
    npm install --no-fund --no-audit
  fi
fi

wait_for_postgres() {
  local attempts="${1:-60}"
  local i=1
  echo "Waiting for PostgreSQL at ${DB_HOST:-DATABASE_URL}..."
  until pg_isready -q -h "${PG_WAIT_HOST}" -p "${PG_WAIT_PORT}" -U "${PG_WAIT_USER}"; do
    if [ "$i" -ge "$attempts" ]; then
      echo "PostgreSQL did not become ready after ${attempts}s at ${PG_WAIT_HOST}:${PG_WAIT_PORT}."
      echo "Boot the Kamal accessory first: bin/kamal accessory boot db"
      exit 1
    fi
    i=$((i + 1))
    sleep 1
  done
}

if [ -n "${DATABASE_URL:-}" ]; then
  eval "$(ruby -e '
    require "uri"
    uri = URI.parse(ENV.fetch("DATABASE_URL"))
    abort("DATABASE_URL is missing a host") unless uri.host
    puts %(PG_WAIT_HOST=#{uri.host})
    puts %(PG_WAIT_PORT=#{uri.port || 5432})
    puts %(PG_WAIT_USER=#{uri.user || "postgres"})
  ')"
  wait_for_postgres
elif [ -n "${DB_HOST:-}" ]; then
  PG_WAIT_HOST="${DB_HOST}"
  PG_WAIT_PORT="${DB_PORT:-5432}"
  PG_WAIT_USER="${POSTGRES_USER:-postgres}"
  wait_for_postgres
fi

launching_rails=false
if [ "${1:-}" = "./bin/dev" ] || [ "${1:-}" = "bin/dev" ] || [ "${1:-}" = "./bin/rails" ] || [ "${1:-}" = "bin/rails" ]; then
  launching_rails=true
fi
# Kamal production: ./bin/thrust ./bin/rails server
if [ "$#" -ge 2 ] && [ "${@: -2:1}" = "./bin/rails" ] && [ "${@: -1:1}" = "server" ]; then
  launching_rails=true
fi

if [ "$launching_rails" = true ]; then
  ./bin/rails db:prepare
  if [ "${RAILS_ENV:-development}" != "production" ]; then
    bundle exec rails db:test:prepare >/dev/null 2>&1 || true
  fi
  if [ "${SEED_ON_BOOT:-false}" = "true" ]; then
    ./bin/rails db:seed || echo "Seed failed (will retry on next boot)"
  fi
fi

exec "$@"
