# Copy to `.env` for local Docker Compose overrides.
# docker compose automatically loads `.env`.

RAILS_ENV=development
RAILS_MAX_THREADS=5
PORT=3000

# Generated on first boot in development if blank.
# SECRET_KEY_BASE=

POSTGRES_USER=rails
POSTGRES_PASSWORD=rails
POSTGRES_DB=rails_quest_development
DATABASE_URL=postgres://rails:rails@db:5432/rails_quest_development
TEST_DATABASE_URL=postgres://rails:rails@db:5432/rails_quest_test

REDIS_URL=redis://redis:6379/0

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Public URL used in share text and QR instructions.
# Production (Kamal) sets this to https://games.booksparkle.kids
APP_HOST=http://localhost:3000
CONFERENCE_SLUG=deccan-rails-conf
