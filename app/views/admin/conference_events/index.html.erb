<h1>Conference events</h1>
<p class="lede">
  The public site shows the live leaderboard. Share a play link so attendees start a run on that event.
</p>

<p><%= link_to "Register conference", new_admin_conference_event_path, class: "btn btn-primary" %></p>

<table class="data">
  <thead>
    <tr>
      <th>Name</th>
      <th>Slug</th>
      <th>Play link</th>
      <th>X handle</th>
      <th>Scores</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @events.each do |event| %>
      <tr>
        <td>
          <%= event.name %>
          <% if event.id == @live.id %><small>live cabinet</small><% end %>
        </td>
        <td><code><%= event.slug %></code></td>
        <td><%= link_to event.play_url, event_root_path(event.slug), target: "_blank", rel: "noopener" %></td>
        <td><%= event.twitter_mention || "—" %></td>
        <td><%= event.scores.count %></td>
        <td><%= link_to "Edit", edit_admin_conference_event_path(event) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
