<% content_for :title, "Run complete — Rails Runner" %>
<% content_for :vite do %>
  <%= vite_javascript_tag "results.ts" %>
<% end %>

<main class="cabinet slim">
  <p class="conf-mark"><%= @game_session.conference_event.name %></p>
  <h1 class="logo small">RUN COMPLETE!</h1>

  <% if @score %>
    <p class="hero-score"><%= format_score(@score.points) %></p>
    <% if @rank && @score.published? %>
      <p class="rank-line">Your Rank <strong>#<%= @rank %></strong></p>
    <% elsif !@score.published? %>
      <p class="rank-line">This run was held for review.</p>
    <% end %>

    <dl class="result-grid">
      <div><dt>Ruby Gems</dt><dd><%= @score.gems_count %></dd></div>
      <div><dt>Questions</dt><dd><%= @score.questions_summary %></dd></div>
      <div><dt>Time left</dt><dd><%= @score.time_remaining %>s</dd></div>
      <div><dt>Deploy bonus</dt><dd><%= format_score(@score.completion_bonus) %></dd></div>
    </dl>
  <% else %>
    <p class="lede">Score is still calculating. Refresh in a moment.</p>
  <% end %>

  <div class="cta-row">
    <% event = @game_session.conference_event %>
    <%= link_to "PLAY AGAIN", event_register_path(event.slug), class: "btn btn-primary" %>
    <%= link_to "LEADERBOARD", event_leaderboard_path(event.slug), class: "btn btn-ghost" %>
    <div class="share-block">
      <% share_text = event.score_share_text(points: format_score(@score&.points)) %>
      <% play_link = event.play_url %>
      <% twitter_url = event.twitter_share_url(text: share_text, url: play_link) %>
      <button type="button" class="btn btn-ghost" data-share
              data-title="Rails Runner"
              data-text="<%= share_text %>"
              data-url="<%= play_link %>">SHARE SCORE</button>
      <% if twitter_url %>
        <%= link_to "SHARE ON X", twitter_url, class: "btn btn-ghost", target: "_blank", rel: "noopener noreferrer", data: { twitter_share: true } %>
      <% end %>
      <p class="share-fallback" data-share-fallback hidden></p>
    </div>
  </div>
</main>
