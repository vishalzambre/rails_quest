<% content_for :title, "Leaderboard — Rails Runner" %>
<% content_for :page_class, "tv-board" %>
<% content_for :vite do %>
  <%= vite_javascript_tag "leaderboard.ts" %>
<% end %>

<main class="tv" data-leaderboard data-scope="<%= @scope %>" data-event="<%= @event.slug %>">
  <header class="tv-head">
    <p><%= @event.name %></p>
    <h1>RAILS RUNNER</h1>
    <p class="tv-sub">
      <% if @scope == "today" %>
        Today's cabinet
      <% elsif @scope == "conference" %>
        Conference cabinet
      <% else %>
        Live cabinet
      <% end %>
    </p>
    <p class="live-line">
      <span class="live-badge" data-live-badge>LIVE</span>
      <span class="live-stamp" data-updated>Waiting for scores…</span>
    </p>
    <nav class="tv-tabs">
      <%= link_to "LIVE", cabinet_leaderboard_path(scope: "live"), class: (@scope == "live" ? "on" : nil) %>
      <%= link_to "TODAY", cabinet_leaderboard_path(scope: "today"), class: (@scope == "today" ? "on" : nil) %>
      <%= link_to "CONFERENCE", cabinet_leaderboard_path(scope: "conference"), class: (@scope == "conference" ? "on" : nil) %>
    </nav>
  </header>

  <p class="high-banner" data-high-banner hidden>NEW HIGH SCORE!</p>
  <p class="latest-ticker" data-latest <%= "hidden".html_safe unless @latest %>>
    <% if @latest %>
      Latest: <strong><%= @latest.player.display_name %></strong> · <%= format_score(@latest.points) %>
    <% end %>
  </p>

  <table class="tv-table">
    <thead>
      <tr>
        <th>#</th>
        <th>PLAYER</th>
        <th>SCORE</th>
      </tr>
    </thead>
    <tbody data-rows>
      <% @scores.each_with_index do |score, index| %>
        <tr data-player="<%= score.player.display_name %>" data-points="<%= score.points %>" data-rank="<%= index + 1 %>">
          <td><%= index + 1 %></td>
          <td>
            <strong><%= score.player.display_name %></strong>
            <% if score.player.company.present? %>
              <small><%= score.player.company %></small>
            <% end %>
          </td>
          <td><%= format_score(score.points) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <p class="tv-empty" data-empty <%= "hidden".html_safe if @scores.any? %>>Waiting for the first deploy…</p>
</main>
