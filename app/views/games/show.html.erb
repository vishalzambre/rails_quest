<% content_for :title, "Ruby Valley — Rails Runner" %>
<% content_for :page_class, "play-screen" %>
<% content_for :vite do %>
  <%= vite_javascript_tag "game.ts" %>
<% end %>

<div
  id="rails-runner"
  data-bootstrap="<%= ERB::Util.json_escape(@bootstrap.to_json) %>"
>
  <div id="game-root"></div>
  <p class="rotate-hint">Turn your phone sideways for the full valley.</p>
  <div class="touch-controls" aria-label="Game controls">
    <div class="move-pads">
      <button type="button" class="pad" data-control="left">LEFT</button>
      <button type="button" class="pad" data-control="right">RIGHT</button>
    </div>
    <button type="button" class="pad jump" data-control="jump">JUMP</button>
  </div>
  <div class="play-chrome">
    <button type="button" class="chrome-btn" data-fullscreen aria-pressed="false">FULL</button>
    <button type="button" class="chrome-btn" data-mute>MUTE</button>
  </div>
</div>
